	partition dim_teams = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Johnsinvi/nba-analytics-dashboard/main/data/raw/team_standings.csv"),[Delimiter=",", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromoteHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    KeepColumns = Table.SelectColumns(PromoteHeaders, {"team_id","Team","Team Name","Conference"})
				in
				    KeepColumns

	annotation PBI_ResultType = Table

