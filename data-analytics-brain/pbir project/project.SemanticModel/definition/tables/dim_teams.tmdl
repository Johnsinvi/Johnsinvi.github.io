table dim_teams
	lineageTag: 747cd423-cdb7-427f-96b5-2b041f2ea560

	column team_id
		dataType: string
		lineageTag: 29956fdd-daff-4f2f-a0cf-5ffe1883d4eb
		summarizeBy: none
		sourceColumn: team_id

		annotation SummarizationSetBy = Automatic

	column Team
		dataType: string
		lineageTag: 0e2b29cb-8740-4b27-b253-0d519839d47d
		summarizeBy: none
		sourceColumn: Team

		annotation SummarizationSetBy = Automatic

	column 'Team Name'
		dataType: string
		lineageTag: bd0ca9d4-4519-44e1-a510-f0d0dd620797
