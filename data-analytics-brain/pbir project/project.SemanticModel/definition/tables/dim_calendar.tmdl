table dim_calendar
	lineageTag: a1b2c3d4-aaaa-bbbb-cccc-000011112222

	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: b2c3d4e5-aaaa-bbbb-cccc-000011112223
		summarizeBy: none
		sourceColumn: Date

		variation Variation
			isDefault
			relationship: b9c14a69-4492-4b53-9534-78be6be8c00d
			defaultHierarchy: LocalDateTable_b4cbb748-0b58-4bf4-b497-2cfba30a1b59.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
