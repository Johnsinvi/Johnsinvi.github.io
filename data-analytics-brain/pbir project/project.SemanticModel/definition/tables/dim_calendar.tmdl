		formatString: 0
		lineageTag: c3d4e5f6-aaaa-bbbb-cccc-000011112224
		summarizeBy: sum
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: int64
		formatString: 0
		lineageTag: d4e5f6a7-aaaa-bbbb-cccc-000011112225
		summarizeBy: sum
