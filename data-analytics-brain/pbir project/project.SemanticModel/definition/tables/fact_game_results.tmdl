table fact_game_results
	lineageTag: 8527bc12-86f8-4b5b-a6f9-b770cbc12c38

	measure Games = COUNTROWS(fact_game_results)
		lineageTag: ab417d50-bc94-47c0-a7ca-9a88cd396fdb

	measure Wins = SUM(fact_game_results[Win])
		lineageTag: 0bfa6ffe-356d-4a99-8904-80713721d0e9

	measure Losses = [Games] - [Wins]
		lineageTag: 08b085ca-8eb4-4056-b4bc-d4ef22d5a558

	measure Win% = DIVIDE([Wins], [Games], 0) * 100
		lineageTag: e60b47ad-d2f9-42f0-affc-8267837bb42b

	measure 'Avg Points Scored' = AVERAGE(fact_game_results[Points Scored])
		lineageTag: 27ba0e3e-d8bc-4b41-99bc-916bd98e6415

	measure 'Avg Points Allowed' = AVERAGE(fact_game_results[Points Allowed])
		lineageTag: 46cd263b-29d5-4a1e-bdb2-15b35606c2ea

	measure 'Avg Point Diff' = AVERAGE(fact_game_results[Point Diff])
		lineageTag: cd94440d-7b5d-4f5c-990c-30f19758c346

	measure 'Home Win%' =
			VAR HomeGames =
				CALCULATE(COUNTROWS(fact_game_results), fact_game_results[Location] = "Home")
			VAR HomeWins =
				CALCULATE(SUM(fact_game_results[Win]), fact_game_results[Location] = "Home")
			RETURN
				DIVIDE(HomeWins, HomeGames, 0) * 100
		lineageTag: 63220c58-2750-459e-ac22-65d7deda5965

	measure 'Away Win%' =
			VAR AwayGames =
				CALCULATE(COUNTROWS(fact_game_results), fact_game_results[Location] = "Away")
			VAR AwayWins =
				CALCULATE(SUM(fact_game_results[Win]), fact_game_results[Location] = "Away")
			RETURN
				DIVIDE(AwayWins, AwayGames, 0) * 100
		lineageTag: 7fb6f4e2-d177-458f-a533-86ace199293b

	measure 'Home Advantage' = [Home Win%] - [Away Win%]
		lineageTag: 1c145ccd-d030-45bc-baa2-19aa25e49dc3

	measure 'Avg Home Point Diff' = CALCULATE(AVERAGE(fact_game_results[Point Diff]), fact_game_results[Location] = "Home")
		lineageTag: 8f40bdfb-bc0a-4648-8640-807d868d38f0

	measure 'Avg Away Point Diff' = CALCULATE(AVERAGE(fact_game_results[Point Diff]), fact_game_results[Location] = "Away")
		lineageTag: f484e983-a8e1-4241-a93e-f78736dcbde6

	measure 'Home Games' = CALCULATE(COUNTROWS(fact_game_results), fact_game_results[Location] = "Home")
		lineageTag: 9baf5956-5757-4705-a58f-490c6c630f5a

	measure 'Away Games' = CALCULATE(COUNTROWS(fact_game_results), fact_game_results[Location] = "Away")
		lineageTag: dec9315b-3f2a-4595-a962-e03973a191f9

	measure 'Home Wins' = CALCULATE(SUM(fact_game_results[Win]), fact_game_results[Location] = "Home")
		lineageTag: 38d8a6a8-83c5-4b53-9fd6-aea313999866

	measure 'Away Wins' = CALCULATE(SUM(fact_game_results[Win]), fact_game_results[Location] = "Away")
		lineageTag: a1375915-fdd9-4f50-be6d-a30730a64196

	measure 'Net Point Diff' = AVERAGE(fact_game_results[Point Diff])
		lineageTag: b1c2d3e4-f5a6-7890-abcd-ef1234567890

	measure 'Close Games' = CALCULATE(COUNTROWS(fact_game_results), ABS(fact_game_results[Point Diff]) <= 5)
		lineageTag: c2d3e4f5-a6b7-8901-bcde-f12345678901

	measure 'Close Game Win%' = DIVIDE(CALCULATE(SUM(fact_game_results[Win]), ABS(fact_game_results[Point Diff]) <= 5), [Close Games], 0) * 100
		lineageTag: d3e4f5a6-b7c8-9012-cdef-012345678902

