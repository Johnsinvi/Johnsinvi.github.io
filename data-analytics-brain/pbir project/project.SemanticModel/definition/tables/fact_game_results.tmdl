	partition fact_game_results = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Johnsinvi/nba-analytics-dashboard/main/data/raw/game_log.csv"),[Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromoteHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangeTypes = Table.TransformColumnTypes(PromoteHeaders,{
				        {"game_id", Int64.Type},
				        {"Date", type date},
				        {"Home Team", type text},
				        {"Home Team Name", type text},
				        {"Home Score", Int64.Type},
				        {"Away Team", type text},
				        {"Away Team Name", type text},
				        {"Away Score", Int64.Type}
				    }),
				    RemoveExhibition = Table.SelectRows(ChangeTypes, each not Text.StartsWith(Text.From([game_id]), "325")),
				    StandardizeAbbr = Table.TransformColumns(RemoveExhibition, {
				        {"Home Team", each let t = _ in
				            if t = "GSW" then "GS"
				            else if t = "NYK" then "NY"
				            else if t = "NOP" then "NO"
				            else if t = "UTA" then "UTAH"
				            else if t = "WAS" then "WSH"
				            else if t = "SAS" then "SA"
				            else t},
				        {"Away Team", each let t = _ in
				            if t = "GSW" then "GS"
				            else if t = "NYK" then "NY"
				            else if t = "NOP" then "NO"
				            else if t = "UTA" then "UTAH"
				            else if t = "WAS" then "WSH"
				            else if t = "SAS" then "SA"
				            else t}
				    }),
				    NbaTeams = {"ATL","BKN","BOS","CHA","CHI","CLE","DAL","DEN","DET","GS","HOU","IND","LAC","LAL","MEM","MIA","MIL","MIN","NO","NY","OKC","ORL","PHI","PHX","POR","SA","SAC","TOR","UTAH","WSH"},
				    RemoveNonNba = Table.SelectRows(StandardizeAbbr, each List.Contains(NbaTeams, [Home Team]) and List.Contains(NbaTeams, [Away Team])),
				    HomeRows = Table.AddColumn(RemoveNonNba, "_Location", each "Home"),
				    HomeSelect = Table.SelectColumns(HomeRows, {"game_id","Date","Home Team","Home Team Name","Home Score","Away Score","_Location"}),
				    HomeRenamed = Table.RenameColumns(HomeSelect, {
				        {"Home Team", "team_id"},
				        {"Home Team Name", "Team Name"},
				        {"Home Score", "Points Scored"},
				        {"Away Score", "Points Allowed"},
				        {"_Location", "Location"}
				    }),
				    HomeWithWin = Table.AddColumn(HomeRenamed, "Win", each if [Points Scored] > [Points Allowed] then 1 else 0, Int64.Type),
				    HomeWithDiff = Table.AddColumn(HomeWithWin, "Point Diff", each [Points Scored] - [Points Allowed], Int64.Type),
				    AwayRows = Table.AddColumn(RemoveNonNba, "_Location", each "Away"),
				    AwaySelect = Table.SelectColumns(AwayRows, {"game_id","Date","Away Team","Away Team Name","Away Score","Home Score","_Location"}),
				    AwayRenamed = Table.RenameColumns(AwaySelect, {
				        {"Away Team", "team_id"},
				        {"Away Team Name", "Team Name"},
				        {"Away Score", "Points Scored"},
				        {"Home Score", "Points Allowed"},
				        {"_Location", "Location"}
				    }),
				    AwayWithWin = Table.AddColumn(AwayRenamed, "Win", each if [Points Scored] > [Points Allowed] then 1 else 0, Int64.Type),
				    AwayWithDiff = Table.AddColumn(AwayWithWin, "Point Diff", each [Points Scored] - [Points Allowed], Int64.Type),
				    Combined = Table.Combine({HomeWithDiff, AwayWithDiff}),
				    AddSeason = Table.AddColumn(Combined, "Season", each
				        let yr = Date.Year([Date]), mo = Date.Month([Date])
				        in if mo >= 10 then Text.From(yr) & "-" & Text.End(Text.From(yr + 1), 2)
				           else Text.From(yr - 1) & "-" & Text.End(Text.From(yr), 2),
				        type text),
				    AddMonth = Table.AddColumn(AddSeason, "Month", each
				        Text.From(Date.Year([Date])) & "-" & Text.PadStart(Text.From(Date.Month([Date])), 2, "0"),
				        type text),
				    FinalTypes = Table.TransformColumnTypes(AddMonth, {{"Date", type date}, {"game_id", Int64.Type}})
				in
				    FinalTypes

	annotation PBI_ResultType = Table

